<svg viewBox="@(-padding / 2) 0 @width @height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@offsetH"
              y="@padding"
              width="@(width - 2 * padding)"
              height="@(height - 2 * padding)"
              fill="@Theme.BackgroundString()"/>
    }
    else
    {
        @Model.TitleX.Render(LayoutTitleX, Theme);
        @Model.TitleY.Render(LayoutTitleY, Theme);
        @Model.AxisX.Render(LayoutAxisX, Theme);
        @Model.AxisY.Render(LayoutAxisY, Theme);

        foreach (Serie<Bubblepoint> serie in Model.Series)
        {
            foreach (Bubblepoint bubble in serie.Data)
            {
                double radius = 16 + (padding / 2 - 16) * (bubble.Radius - Model.AxisB.Min) / Model.AxisB.Size;

                <circle fill="@serie.Color.ToHex()"
                        stroke="@Theme.BackgroundString()"
                        stroke-width="1px"
                        fill-opacity="0.6"
                        vector-effect="non-scaling-stroke"
                        cx="@(offsetH + (int)((bubble.X - Model.AxisX.Min) * scaleH))"
                        cy="@(offsetV - (int)((bubble.Y - Model.AxisY.Min) * scaleV))"
                        r="@((int)radius)px">
                    <title>@bubble.Value.ToString("0.##")</title>
                </circle>
            }
        }
    }
</svg>
