@page "/layout/colors"

<PageTitle>Colors</PageTitle>

<h3>Colors</h3>
<p>
    All charts need to be colored, from the slices of a pie or donut chart
    to the bars of a histogram, and even the series of a line chart.<br />
    <b>Color palettes</b> originated as a convenient way to assign a set of colors to chart data,
    ensuring the colors are clearly distinguishable from one another while maintaining a consistent tone.
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 border">
                <tr>
                    <th>Type</th>
                    <th>.ctor</th>
                    <th>Description</th>
                </tr>
                <tr>
                    <td><span class="token class-name font-monospace">CyclicPalette</span></td>
                    <td class="font-monospace"><span class="token keyword">Color</span>[]</td>
                    <td>Configurable palette with a selected set of colors that cycle continuously</td>
                </tr>
                <tr>
                    <td><span class="token class-name font-monospace">MonotonePalette</span></td>
                    <td class="font-monospace"><span class="token keyword">Color</span>, <span class="token property">Int32</span></td>
                    <td>Monotone palette configurable with a base color, and a lenght </td>
                </tr>
                <tr>
                    <td><span class="token class-name font-monospace">RandomPalette</span></td>
                    <td class="font-monospace"><span class="token property">Int32</span></td>
                    <td>Random color palette configurable with a seed, that determines the sequence</td>
                </tr>
            </table>
        </div>
    </div>
</p>
<p>
    All types of palettes implement the same interface <span class="token keyword font-monospace">IColorStream</span>:
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 border">
                <tr>
                    <th>Method</th>
                    <th>Output</th>
                    <th>Description</th>
                </tr>
                <tr>
                    <td><span class="token function-name font-monospace">Next</span></td>
                    <td class="font-monospace"><span class="token keyword">Color</span></td>
                    <td>Next color taken from the set configured in the constructor</td>
                </tr>
                <tr>
                    <td><span class="token function-name font-monospace">Reset</span></td>
                    <td class="font-monospace"><span class="token property">void</span></td>
                    <td>Reset the palette to the beginning.</td>
                </tr>
            </table>
        </div>
    </div>
</p>
<p>
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col col-sm-6 col-lg-4 col-12">
                    <div class="row g-3">
                        <div class="col-6 col-form-label">Palette</div>
                        <div class="col-6">
                            <select class="form-select" @onchange="@(e => OnPaletteSelect(int.Parse(e?.Value.ToString())))" @key="@palette_index">
                                @foreach (var kvp in available_palettes)
                                {
                                    <option value="@kvp.Key" selected="@(kvp.Key == palette_index)">@kvp.Value.Name</option>
                                }
                            </select>
                        </div>                    
                        <div class="col-12">
                            <PieChart Model="@model" Percentage></PieChart>
                        </div>
                    </div>
                </div>
                <div class="col col-sm-6 col-lg-8 col-12">
                    <div class="h-100 w-100 small border">
                        <pre class="language-csharp m-0 h-100">
                        <code>
 &lt<span class="token tag bold">PieChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>/&gt
 
 @@{
     <span class="token keyword">private</span> <span class="token property">Circulargram</span> model = <span class="token keyword">new</span> <span class="token class-name">Piegram</span>();

     @if (palette_index == 0)
     {
 <text><span class="token keyword">private</span> <span class="token property">IColorStream</span> palette = <span class="token keyword">new</span> <span class="token class-name">RandomPalette</span>();
 </text>
     }
     else
     {
 <text><span class="token keyword">private</span> <span class="token property">IColorStream</span> palette = <span class="token class-name">Palettes</span>.@(available_palettes[palette_index].Name);
 </text>
     }

     @foreach (Slice slice in model)
     {
 <text> model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Slice</span>(<span class="token string">"@slice.Label"</span>, @slice.Value, palette.<span class="token function">Next</span>());
 </text>
     }
 }
                        </code>
                        </pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</p>
