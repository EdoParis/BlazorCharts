@namespace BlazorGraphs.Components

<svg xmlns="http://www.w3.org/2000/svg" 
     style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
     viewBox="@(-LayoutView.Padding / 2) 0 @LayoutView.Width @LayoutView.Height"
     @key="@Model"
     @onmousemove="(e) => LayoutTooltip.Move(e)"
     @onpointerleave="() => LayoutTooltip.Hide()"
     @onpointerenter="(e) => LayoutTooltip.Move(e)">

    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@LayoutView.Padding"
              y="@LayoutView.Padding"
              width="@LayoutView.InternalWidth"
              height="@LayoutView.InternalHeight"
              fill="@Theme.BackgroundString()" />
    }
    else
    {
        @LayoutAxisX.Render(Model.AxisX);
        @LayoutAxisY.Render(Model.AxisY);
        @LayoutTitleX.Render(Model.TitleX);
        @LayoutTitleY.Render(Model.TitleY);

        foreach (Serie<Bubblepoint> serie in Model.Series)
        {
            foreach (Bubblepoint bubble in serie.Data)
            {
                int x = LayoutView.Padding + (int)((bubble.X - Model.AxisX.Min) * LayoutView.InternalWidth / Model.AxisX.Size);
                int y = LayoutView.Height - LayoutView.Padding - (int)((bubble.Y - Model.AxisY.Min) * LayoutView.InternalHeight / Model.AxisY.Size);
                int size = (int)(14 + (LayoutView.Padding - 14) * (bubble.Radius - Model.AxisB.Min) / Model.AxisB.Size);

                <path d="@(Theme.DataMarker.Render(x, y, size, Theme.RoundedMarkers))"
                      fill="@serie.Color.ToHex()"
                      stroke="@serie.Color.ToHex()"
                      stroke-width="1px"
                      fill-opacity="0.6"
                      vector-effect="non-scaling-stroke"
                      class="marker fade-in"
                      @onclick="async () => await OnBubbleClick.InvokeAsync(new BubbleEventArgs(serie, bubble))"
                      @onpointerenter="() => OnBubbleEnter(bubble, serie.Color)"
                      @onpointerleave="() => LayoutTooltip.Hide()">
                </path>
            }
        }
    }
</svg>
@LayoutTooltip.Render(Theme)
