@namespace BlazorGraphs.Components

<svg viewBox="@(-LayoutView.Padding / 2) 0 @LayoutView.Width @LayoutView.Height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@LayoutView.Padding"
              y="@LayoutView.Padding"
              width="@LayoutView.InternalWidth"
              height="@LayoutView.InternalHeight"
              fill="@Theme.BackgroundString()" />
    }
    else
    {
        int originV = LayoutAxisY.StartingPoint.Y - (int)(Model.AxisY.Min * LayoutAxisY.Amplitude / Model.AxisY.Size);

        foreach(Bin bin in Model)
        {
            @if (bin.Value < 0)
            {
                <rect x="@(LayoutAxisX.StartingPoint.X + (int)((bin.Min - Model.AxisX.Min) * LayoutAxisX.Amplitude / Model.AxisX.Size))"
                      y="@originV"
                      width="@((int)((bin.Max - bin.Min) * LayoutAxisX.Amplitude / Model.AxisX.Size))"
                      height="@((int)(bin.Value * LayoutAxisY.Amplitude / Model.AxisY.Size))"
                      fill="@(Model.SecondaryColor.ToHex())"
                      stroke="@(Model.SecondaryColor.ToHex())"
                      class="scale-down"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      @key="@bin"
                      @onclick="async () => await OnClick.InvokeAsync(bin)">
                    <title>@bin.Value.ToString("0.##")</title>
                </rect>
            }
            else
            {
                <rect x="@(LayoutAxisX.StartingPoint.X + (int)((bin.Min - Model.AxisX.Min) * LayoutAxisX.Amplitude / Model.AxisX.Size))"
                      y="@(originV + (int)(bin.Value * LayoutAxisY.Amplitude / Model.AxisY.Size))"
                      width="@((int)((bin.Max - bin.Min) * LayoutAxisX.Amplitude / Model.AxisX.Size))"
                      height="@((int)(-bin.Value * LayoutAxisY.Amplitude / Model.AxisY.Size))"
                      fill="@(Model.PrimaryColor.ToHex())"
                      stroke="@(Model.PrimaryColor.ToHex())"
                      class="scale-up"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      @key="@bin"
                      @onclick="async () => await OnClick.InvokeAsync(bin)">
                    <title>@bin.Value.ToString("0.##")</title>
                </rect>
            }
        }

        if (originV == LayoutView.Padding)
        {
            @LayoutTitleY.At(LayoutView.Padding / 2, LayoutView.Height - LayoutView.Padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(LayoutView.Width / 2, LayoutView.Padding / 4).Render(Model.TitleX);
            @LayoutAxisX.FullInternal().At(originV).WithStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else if (originV == LayoutView.Height - LayoutView.Padding)
        {
            @LayoutTitleY.At(LayoutView.Padding / 2, LayoutView.Padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(LayoutView.Width / 2, LayoutView.Height - LayoutView.Padding / 4).Render(Model.TitleX);
            @LayoutAxisX.TicksInternal().At(originV).WithStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else if (Model.AxisY.Size / 2 > -Model.AxisY.Min)
        {
            @LayoutTitleY.At(LayoutView.Padding / 2, LayoutView.Padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(LayoutView.Width / 2, LayoutView.Height - LayoutView.Padding / 2).Render(Model.TitleX);
            @LayoutAxisX.TicksInternal().At(originV).WithoutStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else
        {
            @LayoutTitleY.At(LayoutView.Padding / 2, LayoutView.Height - LayoutView.Padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(LayoutView.Width / 2, LayoutView.Padding / 2).Render(Model.TitleX);
            @LayoutAxisX.FullInternal().At(originV).WithoutStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
    }
</svg>
