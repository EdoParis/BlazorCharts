@page "/verticalgauge"

<PageTitle>Vertical Gauge</PageTitle>

<h3>Vertical gauge</h3>
<p>
    A Vertical gauge uses a linear dial to show a single metric against a defined scale.
    Like a speedometer, it features a needle or a fill bar that marks the current value within the range.
    The gauge can be flipped horizontally and also be provided with breakpoints to give context to the represented value.
</p>
<div class="row">
    <div class="col col-md-6 col-lg-4 col-12">
        <div class="card fit-content overflow-hidden mb-3 w-100">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <VerticalGauge Model="@model1" Reverse="@reverse"></VerticalGauge>
                    </div>
                    <div class="col-6">
                        <p>
                            <label>Color</label>
                            <input type="color" class="form-control form-control-color w-100" value="@(model1.Color.ToHex())" @onchange="OnColorChanged" />
                        </p>
                        <p>
                            <label>Value</label>
                            <input type="number" class="form-control form-control-color w-100" value="@(model1.Value)" @onchange="OnValueChanged" />
                        </p>
                        <p class="d-flex">
                            <label>Reverse</label>
                            <div class="form-control-lg form-check form-switch form-check-reverse py-0 w-100"><input type="checkbox" class="form-check-input" @bind="@reverse" /></div>
                        </p>
                        <button type="button" class="btn btn-danger text-nowrap w-100 mb-3" @onclick="OnGaugeClear">Clear breakpoints</button>
                        <button type="button" class="btn btn-primary text-nowrap w-100" @onclick="OnBreakPointAdd">Add Breakpoint</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col col-md-6 col-lg-8 col-12">
        <div>
            <h6>Code example</h6>
            <div class="w-100 small border">
                <pre class="language-csharp m-0">
                    <code>
&lt<span class="token tag bold">VerticalGauge</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>
            <span class="token property bold">Reverse</span><span class="token string">="</span>false<span class="token string">"</span>/&gt

@@{
    <span class="token keyword">private</span> <span class="token property">Gaugegram</span> model = <span class="token keyword">new</span> <span class="token class-name">Gaugegram</span>(0, 500, <span class="token string">"Gauge-1"</span>, <span class="token class-name">Color</span>.Navy);
    model.Value = 170;

    <span class="token comment">//OPTIONAL: add breakpoints to set the gauge colors up to the desired value.</span>
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 150,
        Color = <span class="token class-name">Color</span>.Green,
        Label = <span class="token string">"LV-1"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 250,
        Color = <span class="token class-name">Color</span>.Gold,
        Label = <span class="token string">"LV-2"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 500,
        Color = <span class="token class-name">Color</span>.Red,
        Label = <span class="token string">"LV-3"</span>
    };
}
                    </code>
                </pre>
            </div>
        </div>
    </div>
</div>

