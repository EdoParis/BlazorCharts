@namespace BlazorGraphs.Components

<svg xmlns="http://www.w3.org/2000/svg" 
     viewBox="0 0 @width @height"
     style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
     @key="@Model"
     @onmouseleave="() => LayoutTooltip.Hide()"
     @onmousemove="(e) => LayoutTooltip.Move(e)"
     @onmouseenter="(e) => LayoutTooltip.Move(e)">

    @if (Model is null)
    {
        <line stroke="@Theme.AxisColorString()"
              stroke-width="1px"
              vector-effect="non-scaling-stroke"
              x1="@(offsetH)"
              x2="@(width - padding)"
              y1="@(height / 2)"
              y2="@(height / 2)" />
    }
    else
    {
        if (Model.HasBreakPoints)
        {
            double start_value = Model.Axis.Min;
            foreach (Breakpoint breakpoint in Model)
            {
                <rect x="@((int)(offsetH + (start_value - Model.Axis.Min) * scaleH))"
                      y="@padding"
                      width="@((int)((breakpoint.Value - start_value) * scaleH))"
                      height="@(height - 2 * padding)"
                      fill="@breakpoint.Color.ToHex()"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      @onmouseenter="() => OnBreakpointEnter(breakpoint)"
                      @onmouseleave="() => LayoutTooltip.Hide()">
                </rect>
                start_value = breakpoint.Value;
            }
        }
        else if (Model.Axis.Contains(Model.Value))
        {
            <rect x="@offsetH"
                  y="@padding"
                  width="@((int)((Model.Value - Model.Axis.Min) * scaleH))"
                  height="@(height - 2 * padding)"
                  fill="@Model.Color.ToHex()"
                  fill-opacity="0.6"
                  @onmouseenter="OnGaugeEnter"
                  @onmouseleave="() => LayoutTooltip.Hide()">
            </rect>
        }

        if (Reverse)
        {
            @TitleLayout.At(width / 2, height - padding / 2).Render(Model.Title);
            @AxisLayout.FullInternal().At(padding).Render(Model.Axis);
        }
        else
        {
            @TitleLayout.At(width / 2, padding / 2).Render(Model.Title);
            @AxisLayout.FullExternal().At(height - padding).Render(Model.Axis);
        }

        if (Model.HasBreakPoints && Model.Axis.Contains(Model.Value))
        {
            <rect x="@((int)(offsetH + (Model.Value - Model.Axis.Min) * scaleH - padding / 10))"
                  y="@(9 * padding / 10)"
                  width="@(padding / 5)"
                  height="@(height - 9 * padding / 5)"
                  fill="@((Theme.BackgroundColor ?? Color.White).ToHex())"
                  stroke="@Theme.AxisColorString()"
                  stroke-width="1px"
                  fill-opacity="1.0"
                  vector-effect="non-scaling-stroke"
                  @onmouseenter="OnGaugeEnter"
                  @onmouseleave="() => LayoutTooltip.Hide()">
            </rect>
        }
    }
</svg>
@LayoutTooltip.Render()
