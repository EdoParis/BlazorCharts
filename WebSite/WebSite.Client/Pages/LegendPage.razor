@page "/legendbar"

<PageTitle>LegendBar</PageTitle>

<h3>LegendBar</h3>
<p>
    The legend displays descriptive information about the data that are appearing on the chart. 
    There are two different components, one for the horizontal legend and the other for the vertical one.
    Add the component to the page and assign it the data model of the chart you want.
</p>
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col col-sm-6 col-lg-4 col-12">
                <div class="row g-3">
                    <div class="col-12">
                        <table>
                            <tr>
                                <td colspan="2">
                                    <LegendHorizontal Model="@model"></LegendHorizontal>
                                </td>
                            </tr>
                            <tr>
                                <td class="w-100">
                                    <PieChart Model="@model"></PieChart>
                                </td>
                                <td>
                                    <LegendVertical Model="@model"></LegendVertical>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100 text-truncate" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100 text-truncate" @onclick="OnSliceAdd">Add Slice</button></div>
                </div>
            </div>
            <div class="col col-sm-6 col-lg-8 col-12">
                <div class="h-100 w-100 small border">
                    <pre class="language-csharp m-0 h-100">
                        <code>
 &lt<span class="token tag bold">PieChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendVertical</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendHorizontal</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>/&gt
 
 @@{
     <span class="token keyword">private</span> <span class="token property">Piegram</span> model = <span class="token keyword">new</span> <span class="token class-name">Piegram</span>();

     @foreach (Slice slice in model)
     {
 <text> model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Slice</span>(<span class="token string">"@slice.Label"</span>, @slice.Value, <span class="token class-name">Color</span>.<span class="token function">FromArgb</span>(@slice.Color.R, @slice.Color.G, @slice.Color.B));
 </text>
     }
 }
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
