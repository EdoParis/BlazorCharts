@page "/histogram"

<PageTitle>Histogram</PageTitle>

<h3>Histogram</h3>
<p>
    A histogram is a chart that plots the distribution of a numeric variable’s values as a series of bars.
    Each bar typically covers a range of numeric values called bin; a bar’s height indicates the frequency
    of data points with a value within the corresponding bin.
</p>
<div class="row row-cols-1 row-cols-md-2">
    <div class="col">
        <div class="card mx-auto fit-content overflow-hidden mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Primary color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.PrimaryColor.ToHex())" @onchange="@((e) => model1.PrimaryColor = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-6 col-form-label">Secondary color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.SecondaryColor.ToHex())" @onchange="@((e) => model1.SecondaryColor = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-12">
                        <HistChart Model="@model1" OnClick="OnBinClick"></HistChart>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100" @onclick="OnBinAdd">Add Bin</button></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div>
            <h6>Code example</h6>
            <div class="w-100 small border">
                <pre class="language-csharp m-0">
                    <code>
&lt<span class="token tag bold">HistChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span> <span class="token property bold">OnClick</span><span class="token string">="</span><span class="token function">OnClickHandler</span><span class="token string">"</span>/&gt

@@{
    <span class="token comment">//NB: secondary color is optional.</span>
    <span class="token keyword">private</span> <span class="token property">Histogram</span> model = <span class="token keyword">new</span> <span class="token class-name">Histogram</span>(<span class="token string">"Asse-X"</span>, <span class="token string">"Asse-Y"</span>, <span class="token class-name">Color</span>.LightSteelBlue, <span class="token class-name">Color</span>.MediumPurple);

    <span class="token keyword">for</span> (<span class="token variable">int</span> i = 0; i &lt 10; i++)
    {
        model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bin</span>()
        {
            Min = i,
            Max = i + 1,
            Value = 10 + 3 * i
        });
    }

    <span class="token keyword">private</span> <span class="token keyword">void</span> <span class="token function">OnClickHandler</span>(<span class="token class-name">Bin</span> bin)
    {
        <span class="token class-name">Console</span>.<span>WriteLine</span>(<span class="token string">$"clicked bin with value:</span> {bin.Value}<span class="token string">"</span>);
    }
}
                    </code>
                </pre>
            </div>
        </div>
    </div>
</div>
