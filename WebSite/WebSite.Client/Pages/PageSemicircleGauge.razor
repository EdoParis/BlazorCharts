@page "/semicirclegauge"

<PageTitle>Semicircle Gauge</PageTitle>

<h3>Semicircle gauge</h3>
<p>
    A semicircle gauge uses a circular dial to show a single metric against a defined scale.
    Like a speedometer, it features a needle or a fill bar that marks the current value within the range.
    The gauge can also be provided with breakpoints to give context to the represented value.
</p>
<div class="d-flex flex-wrap justify-content-center">
    <ChartCard Title="Semicircle gauge">
        <SemiCircleGauge Model="@model1"></SemiCircleGauge>
    </ChartCard>
    <ChartCard Title="Semicircle gauge and breakpoints">
        <SemiCircleGauge Model="@model2"></SemiCircleGauge>
    </ChartCard>
</div>
<p>
    <h6>Code example</h6>
    <div class="w-100 small border">
        <pre class="language-csharp m-0">
            <code>
&lt<span class="token tag bold">SemiCircleGauge</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>
            <span class="token property bold">Reverse</span><span class="token string">="</span>false<span class="token string">"</span>/&gt

@@{
    <span class="token keyword">private</span> <span class="token property">Gaugegram</span> model = <span class="token keyword">new</span> <span class="token class-name">Gaugegram</span>(0, 500, <span class="token string">"Gauge-1"</span>, <span class="token class-name">Color</span>.Navy);
    model.Value = 170;

    <span class="token comment">//OPTIONAL: add breakpoints to set the gauge colors up to the desired value.</span>
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 150,
        Color = <span class="token class-name">Color</span>.Green,
        Label = <span class="token string">"LV-1"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 250,
        Color = <span class="token class-name">Color</span>.Gold,
        Label = <span class="token string">"LV-2"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 500,
        Color = <span class="token class-name">Color</span>.Red,
        Label = <span class="token string">"LV-3"</span>
    };
}
            </code>
        </pre>
    </div>
</p>
