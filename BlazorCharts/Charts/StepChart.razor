<svg viewBox="@(-padding / 2) 0 @width @height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@offsetH"
              y="@padding"
              width="@(width - 2 * padding)"
              height="@(height - 2 * padding)"
              fill="@Theme.BackgroundString()"/>
    }
    else
    {
        @LayoutAxisX.Render(Model.AxisX);
        @LayoutAxisY.Render(Model.AxisY);
        @LayoutTitleX.Render(Model.TitleX);
        @LayoutTitleY.Render(Model.TitleY);

        foreach (Serie<Datapoint> serie in Model.Series)
        {
            <g>
                <path fill="none"
                      stroke="@serie.Color.ToHex()"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      d="@LinePath(serie)"
                      @key="@serie">
                    <title>@($"{serie.Label}")</title>
                </path>

                @if (ShowPoints)
                {
                    foreach (Datapoint point in serie.Data)
                    {
                        <circle fill="@(Theme.BackgroundColor.HasValue? Theme.BackgroundColor.Value.ToHex() : serie.Color.ToHex())"
                                stroke="@serie.Color.ToHex()"
                                stroke-width="1px"
                                vector-effect="non-scaling-stroke"
                                cx="@(offsetH + (int)((point.X - Model.AxisX.Min) * scaleH))"
                                cy="@(offsetV - (int)((point.Y - Model.AxisY.Min) * scaleV))"
                                r="8px">
                            <title>(@point.X.ToString("0.##"), @point.Y.ToString("0.##"))</title>
                        </circle>
                    }
                }
            </g>
        }
    }
</svg>
