@page "/horizontalgauge"

<PageTitle>Horizontal Gauge</PageTitle>

<h3>Horizontal gauge</h3>
<p>
    A horizontal gauge uses a linear dial to show a single metric against a defined scale.
    Like a speedometer, it features a needle or a fill bar that marks the current value within the range.
    The gauge can be flipped vertically and also be provided with breakpoints to give context to the represented value.
</p>
<div class="row row-cols-1 row-cols-md-2">
    <div class="col">
        <div class="card mx-auto fit-content overflow-hidden mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.Color.ToHex())" @onchange="OnColorChanged" /></div>
                    <div class="col-6 col-form-label">Value</div>
                    <div class="col-6"><input type="number" class="form-control form-control-color w-100" value="@(model1.Value)" @onchange="OnValueChanged" /></div>
                    <div class="col-6">Reverse</div>
                    <div class="col-6"><div class="col-6 form-control-lg form-check form-switch form-check-reverse py-0 w-100"><input type="checkbox" class="form-check-input" @bind="@reverse" /></div></div>
                    <div class="col-12">
                        <HorizontalGauge Model="@model1" Reverse="@reverse"></HorizontalGauge>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger text-nowrap w-100" @onclick="OnGaugeClear">Clear breakpoints</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary text-nowrap w-100" @onclick="OnBreakPointAdd">Add Breakpoint</button></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div>
            <h6>Code example</h6>
            <div class="w-100 small border">
                <pre class="language-csharp m-0">
                    <code>
&lt<span class="token tag bold">HorizontalGauge</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>
            <span class="token property bold">Reverse</span><span class="token string">="</span>false<span class="token string">"</span>/&gt

@@{
    <span class="token keyword">private</span> <span class="token property">Gaugegram</span> model = <span class="token keyword">new</span> <span class="token class-name">Gaugegram</span>(0, 500, <span class="token string">"Gauge-1"</span>, <span class="token class-name">Color</span>.Navy);
    model.Value = 170;

    <span class="token comment">//OPTIONAL: add breakpoints to set the gauge colors up to the desired value.</span>
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 150,
        Color = <span class="token class-name">Color</span>.Green,
        Label = <span class="token string">"LV-1"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 250,
        Color = <span class="token class-name">Color</span>.Gold,
        Label = <span class="token string">"LV-2"</span>
    };
    model.<span class="token function">AddBreakpoint</span>()
    {
        Value = 500,
        Color = <span class="token class-name">Color</span>.Red,
        Label = <span class="token string">"LV-3"</span>
    };
}
                    </code>
                </pre>
            </div>
        </div>
    </div>
</div>
