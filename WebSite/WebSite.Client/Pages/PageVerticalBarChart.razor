@page "/verticalbarchart"

<PageTitle>BarChart</PageTitle>

<h3>Vertical Barchart</h3>
<p>
    A bar chart plots numeric values for levels of a categorical feature as bars.
    Levels are plotted on one chart axis, and values are plotted on the other axis.
    Each categorical value claims one bar, and the length of each bar corresponds to the bar’s value
</p>
<p>
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 bg-white border">
                <tr class="shadow-sm">
                    <th>Property</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
                <tr>
                    <td>Theme</td>
                    <td class="font-monospace"><span class="token keyword">Theme</span><a class="bi-arrow-90deg-right px-2" href="themes"></a></td>
                    <td>Chart customization colors</td>
                </tr>
                <tr>
                    <td>Model</td>
                    <td class="font-monospace"><span class="token keyword">Bargram</span></td>
                    <td>Data model</td>
                </tr>
                <tr>
                    <td>OnClick</td>
                    <td class="font-monospace"><span class="token keyword">EventCallback</span>&lt<span class="token keyword">Bar</span>&gt</td>
                    <td>Bar click event</td>
                </tr>
                <tr>
                    <td>AspectRatio</td>
                    <td class="font-monospace"><span class="token property">Double</span></td>
                    <td>Define the width/height ratio of the chart</td>
                </tr>
            </table>
        </div>
    </div>
</p>
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col col-sm-6 col-lg-4 col-12">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Primary color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.PrimaryColor.ToHex())" @onchange="@((e) => model1.PrimaryColor = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-6 col-form-label">Secondary color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.SecondaryColor.ToHex())" @onchange="@((e) => model1.SecondaryColor = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-6 col-form-label">Aspect ratio</div>
                    <div class="col-6">
                        <select class="form-select" @bind="@aspectratio">
                            <option value="@AspectRatios.Square">@nameof(AspectRatios.Square)</option>
                            <option value="@AspectRatios.Vertical">@nameof(AspectRatios.Vertical)</option>
                            <option value="@AspectRatios.Portrait">@nameof(AspectRatios.Portrait)</option>
                            <option value="@AspectRatios.Standard">@nameof(AspectRatios.Standard)</option>
                            <option value="@AspectRatios.Photo">@nameof(AspectRatios.Photo)</option>
                            <option value="@AspectRatios.Widescreen">@nameof(AspectRatios.Widescreen)</option>
                            <option value="@AspectRatios.Panoramic">@nameof(AspectRatios.Panoramic)</option>
                            <option value="@AspectRatios.Ultrawide">@nameof(AspectRatios.Ultrawide)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <VerticalBarChart Model="@model1" OnClick="OnBarClick" AspectRatio="@aspectratio"></VerticalBarChart>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100 text-truncate" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100 text-truncate" @onclick="OnBarAdd">Add Bar</button></div>
                </div>
            </div>
            <div class="col col-sm-6 col-lg-8 col-12">
                <div class="h-100 w-100 small border">
                    <pre class="language-csharp m-0 h-100">
                        <code>
 &lt<span class="token tag bold">VerticalBarChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span> <span class="token property bold">OnClick</span><span class="token string">="</span><span class="token function">OnClickHandler</span><span class="token string">"</span>/&gt
 
 @@{
     <span class="token comment">//NB: secondary color is optional.</span>
     <span class="token keyword">private</span> <span class="token property">Bargram</span> model = <span class="token keyword">new</span> <span class="token class-name">Bargram</span>(<span class="token string">"Asse-X"</span>, <span class="token class-name">Color</span>.LightSteelBlue, <span class="token class-name">Color</span>.MediumPurple);
 
     <span class="token keyword">for</span> (<span class="token variable">int</span> i = 0; i &lt 10; i++)
     {
         model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bar</span>()
         {
             Label = <span class="token string">$"Bar-</span>{i}<span class="token string">"</span>,
             Value = 93 - i * i
         });
     }
 
     <span class="token keyword">private</span> <span class="token keyword">void</span> <span class="token function">OnClickHandler</span>(<span class="token class-name">Bar</span> bar)
     {
         <span class="token class-name">Console</span>.<span>WriteLine</span>(<span class="token string">$"clicked bar with label:</span> {bar.Label}<span class="token string">"</span>);
     }
 }
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
