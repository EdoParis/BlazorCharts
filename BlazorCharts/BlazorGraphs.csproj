<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.2.0</Version>
    <Title>BlazorGraphs</Title>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor; dotnet; gauges; charts; blazor-charts; data-visualization; svg; no-js</PackageTags>
    <PackageIcon>ICON.png</PackageIcon>
    <Authors>Edoardo Paris;</Authors>
	  <PackageProjectUrl>https://www.BlazorGraphs.it</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/EdoParis/BlazorCharts</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
    <Description>Lightweight library to draw .svg charts and gauges for Blazor (No Javascript)</Description>
    <PackageReleaseNotes>
		- Added rounded theme
		- Added tooltip color customization
		- Added click events to cartesian charts
		- Added marker shape customization to datapoints and series
		- Improved tooltip touch interaction
	</PackageReleaseNotes>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ICON.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
