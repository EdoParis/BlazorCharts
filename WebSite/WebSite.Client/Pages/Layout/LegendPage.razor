@page "/layout/legendbar"

<PageTitle>LegendBar</PageTitle>

<h3>LegendBar</h3>
<p>
    The legend displays descriptive information about the data that are appearing on the chart. 
    There are two different components, one for the horizontal legend and the other for the vertical one.
    Add the component to the page and assign it the data model of the chart you want.
</p>
<p>
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 border">
                <tr class="shadow-sm">
                    <th>Property</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
                <tr>
                    <td>Model</td>
                    <td class="font-monospace"><span class="token keyword">ILegend</span></td>
                    <td>Interface implemented by all data model</td>
                </tr>
                <tr>
                    <td>Marker</td>
                    <td class="font-monospace"><span class="token keyword">MarkerShapes</span></td>
                    <td>Enumeration of available marker shapes</td>
                </tr>
                <tr>
                    <td>Theme</td>
                    <td class="font-monospace"><span class="token keyword">Theme</span><a class="bi-arrow-90deg-right px-2" href="layout/themes"></a></td>
                    <td>Chart customization colors</td>
                </tr>
            </table>
        </div>
    </div>
</p>
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col col-sm-6 col-lg-4 col-12">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Marker</div>
                    <div class="col-6">
                        <select class="form-select" @bind="@marker">
                            <option value="@MarkerShapes.Circle">@nameof(MarkerShapes.Circle)</option>
                            <option value="@MarkerShapes.Square">@nameof(MarkerShapes.Square)</option>
                            <option value="@MarkerShapes.Segment">@nameof(MarkerShapes.Segment)</option>
                            <option value="@MarkerShapes.Slice">@nameof(MarkerShapes.Slice)</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <table>
                            <tr>
                                <td colspan="2">
                                    <LegendHorizontal Model="@model" Marker="@marker"></LegendHorizontal>
                                </td>
                            </tr>
                            <tr>
                                <td class="w-100">
                                    <PolarAreaChart Model="@model"></PolarAreaChart>
                                </td>
                                <td>
                                    <LegendVertical Model="@model" Marker="@marker"></LegendVertical>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100 text-truncate" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100 text-truncate" @onclick="OnSliceAdd">Add Slice</button></div>
                </div>
            </div>
            <div class="col col-sm-6 col-lg-8 col-12">
                <div class="h-100 w-100 small border">
                    <pre class="language-csharp m-0 h-100">
                        <code>
 &lt<span class="token tag bold">PolarAreaChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendVertical</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span> <span class="token property bold">Marker</span><span class="token string">="</span>@@<span class="token class-name">MarkerShapes</span>.Circle<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendHorizontal</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span> <span class="token property bold">Marker</span><span class="token string">="</span>@@<span class="token class-name">MarkerShapes</span>.Circle<span class="token string">"</span>/&gt
 
 @@{
     <span class="token keyword">private</span> <span class="token property">Circulargram</span> model = <span class="token keyword">new</span> <span class="token class-name">Piegram</span>();
     <span class="token keyword">private</span> <span class="token property">IColorStream</span> palette = <span class="token keyword">new</span> <span class="token class-name">RandomPalette</span>();

     @foreach (Slice slice in model)
     {
 <text> model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Slice</span>(<span class="token string">"@slice.Label"</span>, @slice.Value, palette.<span class="token function">Next</span>());
 </text>
     }
 }
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
