@namespace BlazorGraphs.Components

<div style="position: relative;" @onmousemove="OnMouseHover">
    <svg xmlns="http://www.w3.org/2000/svg" 
         viewBox="0 0 @width @height"
         style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()" 
         @key="@Model"
         @onmouseleave="() => SelectedSlice = null">

        @if (Model is null || Model.IsEmpty)
        {
            <circle fill="@Theme.BackgroundString()"
                    fill-opacity="1.0"
                    stroke="@Theme.AxisColorString()"
                    stroke-width="1px"
                    vector-effect="non-scaling-stroke"
                    cx="@((width / 2))"
                    cy="@((height / 2))"
                    r="@((Math.Min(width, height) - 2 * padding) / 2)"
                    style="pointer-events: none;" />
        }
        else
        {
            double progress = 0;
            foreach(Slice slice in Model)
            {
                if (slice.Value >= Model.Total)
                {
                    <circle fill="@slice.Color.ToHex()"
                            class="fade-in"
                            stroke="@Theme.BackgroundString()"
                            fill-opacity="0.6"
                            stroke-width="1px"
                            vector-effect="non-scaling-stroke"
                            cx="@((width / 2))"
                            cy="@((height / 2))"
                            r="@((Math.Min(width, height) - 2 * padding) / 2)"
                            @key="@slice"
                            @onclick="async () => await OnClick.InvokeAsync(slice)"
                            @onmouseenter="() => SelectedSlice = slice"
                            @onmouseleave="() => SelectedSlice = null">
                    </circle>
                }
                else
                {
                    <path fill="@slice.Color.ToHex()"
                          class="fade-in"
                          stroke="@Theme.BackgroundString()"
                          fill-opacity="0.6"
                          stroke-width="1px"
                          vector-effect="non-scaling-stroke"
                          d="@SlicePath(slice, 2 * Math.PI * progress)"
                          @key="@slice"
                          @onclick="async () => await OnClick.InvokeAsync(slice)"
                          @onmouseenter="() => SelectedSlice = slice"
                          @onmouseleave="() => SelectedSlice = null">
                    </path>
                }

                Point text_position = 10 * slice.Value > Model.Total ? 
                                      SliceMidPoint(slice, 2 * Math.PI * progress) : 
                                      SliceExternalPoint(slice, 2 * Math.PI * progress);
                if (Percentage)
                {
                    @LayoutTextSlice.At(text_position).Render($"{(100 * slice.Value / Model.Total).ToString("0.#")}%");
                }
                else
                {
                    @LayoutTextSlice.At(text_position).Render(slice.Value);
                }
                progress += slice.Value / Model.Total;
            }
            @LayoutTextTitle.Render(Model.Title)
        }
    </svg>
    @if (SelectedSlice.HasValue)
    {
        <Tooltip Position="TooltipPosition" Theme="Theme">
            <table>
                <tr>
                    <td colspan="2" style="text-align: center;">@SelectedSlice.Value.Label</td>
                </tr>
                <tr>
                    <td>
                        <svg width="1.5em" height="1em" viewBox="0 0 15 10">
                            <path d="M 1 9 L 1 1 A 8 8 0 0 1 9 9 Z"
                                  fill="@(SelectedSlice.Value.Color.ToHex())" />
                        </svg>
                    </td>
                    <td>
                        @if (Percentage)
                        {
                            <label>@((100 * SelectedSlice.Value.Value / Model.Total).ToString("0.#"))%</label>
                        }
                        else
                        {
                            <label>@(SelectedSlice.Value.Value.ToString("0.##"))</label>
                        }
                    </td>
                </tr>
            </table>
        </Tooltip>
    }
</div>