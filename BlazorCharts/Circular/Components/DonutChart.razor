@namespace BlazorGraphs.Components

<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 @width @height"
     style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
     @key="@Model"
     @onpointerleave="() => LayoutTooltip.Hide()"
     @onpointermove="(e) => LayoutTooltip.Move(e)"
     @onpointerenter="(e) => LayoutTooltip.Move(e)">

    @if (Model is null || Model.IsEmpty)
    {
        <circle fill="@Theme.BackgroundString()"
                fill-opacity="1.0"
                stroke="@Theme.AxisColorString()"
                stroke-width="1px"
                vector-effect="non-scaling-stroke"
                cx="@((width / 2))"
                cy="@((height / 2))"
                r="@((Math.Min(width, height) - 2 * padding) / 2)"
                style="pointer-events: none;" />

        <circle fill="@Theme.BackgroundString()"
                fill-opacity="1.0"
                stroke="@Theme.AxisColorString()"
                stroke-width="1px"
                vector-effect="non-scaling-stroke"
                cx="@((width / 2))"
                cy="@((height / 2))"
                r="@((Math.Min(width, height) - 2 * padding) / 3)"
                style="pointer-events: none;" />
    }
    else
    {
        double progress = 0;
        foreach (Slice slice in Model)
        {
            <path fill="@slice.Color.ToHex()"
                  class="fade-in"
                  stroke="@Theme.BackgroundString()"
                  fill-opacity="0.6"
                  stroke-width="1px"
                  vector-effect="non-scaling-stroke"
                  d="@SlicePath(slice, 2 * Math.PI * progress)"
                  @onclick="async () => await OnClick.InvokeAsync(slice)"
                  @onpointerenter="() => OnSliceEnter(slice)"
                  @onpointerleave="() => LayoutTooltip.Hide()">
            </path>

            if (slice.Value != Model.Total && 40 * slice.Value >= Model.Total)
            {
                Point text_position = 10 * slice.Value > Model.Total ? 
                                      SliceMidPoint(slice, 2 * Math.PI * progress) : 
                                      SliceExternalPoint(slice, 2 * Math.PI * progress);
                if (Percentage)
                {
                    @LayoutSliceValue.At(text_position).Render($"{(100 * slice.Value / Model.Total).ToString("0.#")}%");
                }
                else
                {
                    @LayoutSliceValue.At(text_position).Render(slice.Value);
                }
            }
            progress += slice.Value / Model.Total;
        }
        @LayoutTextTitle.Render(Model.Title);
        @LayoutTotalValue.Render(Model.Total);
    }
</svg>
@LayoutTooltip.Render()