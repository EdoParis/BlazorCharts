@page "/horizontalbarchart"

<PageTitle>BarChart</PageTitle>

<h3>Horizontal Barchart</h3>
<p>
    A bar chart plots numeric values for levels of a categorical feature as bars.
    Levels are plotted on one chart axis, and values are plotted on the other axis.
    Each categorical value claims one bar, and the length of each bar corresponds to the bar’s value
</p>
<div class="d-flex flex-wrap justify-content-center">
    <ChartCard Title="Horizontal barchart">
        <HorizontalBarChart Model="@model1" OnClick="OnBarClick"></HorizontalBarChart>
    </ChartCard>
    <ChartCard Title="Bicolored barchart">
        <HorizontalBarChart Model="@model3" OnClick="OnBarClick"></HorizontalBarChart>
    </ChartCard>
    <ChartCard Title="Negative barchart">
        <HorizontalBarChart Model="@model2" OnClick="OnBarClick"></HorizontalBarChart>
    </ChartCard>
</div>
<p>
    <h6>Code example</h6>
    <div class="w-100 small border">
        <pre class="language-csharp m-0">
            <code>
&lt<span class="token tag bold">HorizontalBarChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span> <span class="token property bold">OnClick</span><span class="token string">="</span><span class="token function">OnClickHandler</span><span class="token string">"</span>/&gt

@@{
    <span class="token comment">//NB: secondary color is optional.</span>
    <span class="token keyword">private</span> <span class="token property">Bargram</span> model = <span class="token keyword">new</span> <span class="token class-name">Bargram</span>(<span class="token string">"Asse-X"</span>, <span class="token class-name">Color</span>.LightSteelBlue, <span class="token class-name">Color</span>.MediumPurple);

    <span class="token keyword">for</span> (<span class="token variable">int</span> i = 0; i &lt 10; i++)
    {
        model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bar</span>()
        {
            Label = <span class="token string">$"Bar-</span>{i}<span class="token string">"</span>,
            Value = 93 - i * i
        });
    }

    <span class="token keyword">private</span> <span class="token keyword">void</span> <span class="token function">OnClickHandler</span>(<span class="token class-name">Bar</span> bar)
    {
        <span class="token class-name">Console</span>.<span>WriteLine</span>(<span class="token string">$"clicked bar with label:</span> {bar.Label}<span class="token string">"</span>);
    }
}
            </code>
        </pre>
    </div>
</p>
