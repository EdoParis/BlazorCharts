@namespace BlazorGraphs.Components

<svg viewBox="@(-LayoutView.Padding / 2) 0 @LayoutView.Width @LayoutView.Height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@LayoutView.Padding"
              y="@LayoutView.Padding"
              width="@LayoutView.InternalWidth"
              height="@LayoutView.InternalHeight"
              fill="@Theme.BackgroundString()"/>
    }
    else
    {
        @LayoutAxisX.Render(Model.AxisX);
        @LayoutAxisY.Render(Model.AxisY);
        @LayoutTitleX.Render(Model.TitleX);
        @LayoutTitleY.Render(Model.TitleY);

        foreach (Serie<Datapoint> serie in Model.Series)
        {
            foreach (Datapoint point in serie.Data)
            {
                <circle fill="@serie.Color.ToHex()"
                        stroke="@Theme.BackgroundString()"
                        stroke-width="2px"
                        vector-effect="non-scaling-stroke"
                        cx="@(LayoutView.Padding + (int)((point.X - Model.AxisX.Min) * LayoutView.InternalWidth / Model.AxisX.Size))"
                        cy="@(LayoutView.Height - LayoutView.Padding - (int)((point.Y - Model.AxisY.Min) * LayoutView.InternalHeight / Model.AxisY.Size))"
                        r="8px"
                        class="fade-in"
                        style="paint-order: stroke fill;"
                        @key="@point">
                    <title>(@point.X.ToString("0.##"), @point.Y.ToString("0.##"))</title>
                </circle>
            }
        }
    }
</svg>
