@page "/bubblechart"

<PageTitle>BubbleChart</PageTitle>

<h3>Bubblechart</h3>
<p>
    A bubble chart is type of chart that show collection of circles,
    each defined by the coordinates of its center and its radius.
</p>
<p>
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 bg-white border">
                <tr class="shadow-sm">
                    <th>Property</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
                <tr>
                    <td>Theme</td>
                    <td class="font-monospace"><span class="token keyword">Theme</span><a class="bi-arrow-90deg-right px-2" href="themes"></a></td>
                    <td>Chart customization colors</td>
                </tr>
                <tr>
                    <td>Model</td>
                    <td class="font-monospace"><span class="token keyword">Bubblegram</span></td>
                    <td>Data model</td>
                </tr>
                <tr>
                    <td>AspectRatio</td>
                    <td class="font-monospace"><span class="token property">Double</span></td>
                    <td>Define the width/height ratio of the chart</td>
                </tr>
            </table>
        </div>
    </div>
</p>
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col col-sm-6 col-lg-4 col-12">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Title X</div>
                    <div class="col-6"><input type="text" class="form-control" value="@(model?.TitleX)" @onchange="@((e) => model.TitleX = e?.Value?.ToString())" /></div>
                    <div class="col-6 col-form-label">Title Y</div>
                    <div class="col-6"><input type="text" class="form-control" value="@(model?.TitleY)" @onchange="@((e) => model.TitleY = e?.Value?.ToString())" /></div>
                    <div class="col-6 col-form-label">Aspect ratio</div>
                    <div class="col-6">
                        <select class="form-select" @bind="@aspectratio">
                            <option value="@AspectRatios.Square">@nameof(AspectRatios.Square)</option>
                            <option value="@AspectRatios.Higher">@nameof(AspectRatios.Higher)</option>
                            <option value="@AspectRatios.Vertical">@nameof(AspectRatios.Vertical)</option>
                            <option value="@AspectRatios.Portrait">@nameof(AspectRatios.Portrait)</option>
                            <option value="@AspectRatios.Standard">@nameof(AspectRatios.Standard)</option>
                            <option value="@AspectRatios.Photo">@nameof(AspectRatios.Photo)</option>
                            <option value="@AspectRatios.Widescreen">@nameof(AspectRatios.Widescreen)</option>
                            <option value="@AspectRatios.Panoramic">@nameof(AspectRatios.Panoramic)</option>
                            <option value="@AspectRatios.Ultrawide">@nameof(AspectRatios.Ultrawide)</option>
                            <option value="@AspectRatios.Ultralarge">@nameof(AspectRatios.Ultralarge)</option>
                        </select>
                    </div>
                    <div class="col-6 col-form-label">Next color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(serie_color.ToHex())" @onchange="@((e) => serie_color = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-12">
                        <BubbleChart Model="@model" AspectRatio="@aspectratio"></BubbleChart>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100 text-truncate" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100 text-truncate" @onclick="OnSeriesAdd">Add Serie</button></div>
                </div>
            </div>
            <div class="col col-sm-6 col-lg-8 col-12">
                <div class="h-100 w-100 small border">
                    <pre class="language-csharp m-0 h-100">
                        <code>
 &lt<span class="token tag bold">BubbleChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>
        <span class="token property bold">AspectRatio</span><span class="token string">="</span><span class="token class-name">AspectRatios</span>.Square<span class="token string">"</span>/&gt
 
 @@{
     <span class="token keyword">private</span> <span class="token property">Bubblegram</span> model = <span class="token keyword">new</span> <span class="token class-name">Bubblegram</span>(<span class="token string">"X1"</span>, <span class="token string">"Y1"</span>);
 
     <span class="token class-name">List</span>&lt<span class="token class-name">Bubblepoint</span>&gt bubbles1 = <span class="token keyword">new</span>();
     <span class="token class-name">List</span>&lt<span class="token class-name">Bubblepoint</span>&gt bubbles2 = <span class="token keyword">new</span>();
 
     <span class="token keyword">for</span> (<span class="token variable">int</span> i = 0; i &lt 10; i++)
     {
         bubbles1.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bubblepoint</span>(){ X = i, Y = i, Value = 25 + i });
         bubbles2.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bubblepoint</span>(){ X = i, Y = 2 * i, Value = 10 + i});
     }
 
     model.<span class="token function">AddSerie</span>(<span class="token string">"Bubbles1"</span>, <span class="token class-name">Color</span>.MediumPurple, bubbles1);
     model.<span class="token function">AddSerie</span>(<span class="token string">"Bubbles2"</span>, <span class="token class-name">Color</span>.OrangeRed, bubbles2);
 }
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
