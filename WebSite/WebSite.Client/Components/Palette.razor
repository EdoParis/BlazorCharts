@if (Colors != null && Size > 0)
{
    <svg viewBox="0 0 @(Size * 10) 10" 
         xmlns="http://www.w3.org/2000/svg">

        @for (int i=0; i<Size; i++)
        {
            Color current_color = Colors.Next();

            <rect y="0"
                  x="@(i * 10)"
                  height="10"
                  width="10"
                  fill-opacity="0.6"
                  fill="@current_color.ToHex()">
                <title>@current_color.ToHex()</title>
            </rect>
        }
    </svg>
}

@code {
    [Parameter] public IColorStream Colors { get; set; }
    [Parameter] public Int32 Size { get; set; }
}
