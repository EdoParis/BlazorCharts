@page "/themes"

<PageTitle>Themes</PageTitle>

<h3>Themes</h3>
<p>
    All the charts, gauges and legends in the library can be associated with a theme to define their style.
</p>
<h6>Properties</h6>
<p>
    The theme provides four properties for customization, each of which has a default behavior that is activated when this is <span class="token keyword font-monospace">null</span>,
    so you only need to set the value for the ones you need.
</p>
<p>
    <div class="card overflow-hidden">
        <div class="card-body overflow-auto">
            <table class="table text-nowrap align-middle mb-0 bg-white border">
                <tr class="shadow-sm">
                    <th>Name</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Default behaviour</th>
                </tr>
                <tr>
                    <td>BackGroundColor</td>
                    <td class="font-monospace"><span class="token property">Color</span>?</td>
                    <td>Chart area color</td>
                    <td class="font-monospace"><span class="token string">transparent</span></td>
                </tr>
                <tr>
                    <td>AxisColor</td>
                    <td class="font-monospace"><span class="token property">Color</span>?</td>
                    <td>Color of the chart axes</td>
                    <td class="font-monospace"><span class="token string">currentColor</span></td>
                </tr>
                <tr>
                    <td>TextColor</td>
                    <td class="font-monospace"><span class="token property">Color</span>?</td>
                    <td>Color of the text and tick labels of the chart</td>
                    <td class="font-monospace"><span class="token string">currentColor</span></td>
                </tr>
                <tr>
                    <td>FontFamily</td>
                    <td class="font-monospace"><span class="token keyword">string</span></td>
                    <td>Chart text font-family </td>
                    <td class="font-monospace"><span class="token string">inherit</span></td>
                </tr>
            </table>
        </div>
    </div>
</p>
<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col col-sm-6 col-lg-4 col-12">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Theme</div>
                    <div class="col-6">
                        <select class="form-select" @onchange="@(e => OnThemeSelect(int.Parse(e?.Value.ToString())))" @key="@theme_index">
                            @foreach(var kvp in available_themes)
                            {
                                <option value="@kvp.Key" selected="@(kvp.Key == theme_index)">@kvp.Value.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-form-label">Background</div>
                    <div class="col-6">
                        <input type="color" 
                               class="form-control form-control-color w-100"
                               value="@((BackgroundTheme ?? Color.Black).ToHex())"
                               title="@(BackgroundTheme.HasValue ? $"RGB: ({BackgroundTheme.Value.R}, {BackgroundTheme.Value.G}, {BackgroundTheme.Value.B})" : "transparent")" 
                               @onchange="@(e => BackgroundTheme = ColorTranslator.FromHtml(e?.Value?.ToString()))" />
                    </div>
                    <div class="col-6 col-form-label">Axis</div>
                    <div class="col-6">
                        <input type="color" 
                               class="form-control form-control-color w-100" 
                               value="@((AxisTheme ?? Color.Black).ToHex())"
                               title="@(AxisTheme.HasValue ? $"RGB: ({AxisTheme.Value.R}, {AxisTheme.Value.G}, {AxisTheme.Value.B})" : "currentColor")"
                               @onchange="@(e => AxisTheme = ColorTranslator.FromHtml(e?.Value?.ToString()))" />
                    </div>
                    <div class="col-6 col-form-label">Text</div>
                    <div class="col-6">
                        <input type="color"
                               class="form-control form-control-color w-100"
                               value="@((TextTheme ?? Color.Black).ToHex())"
                               title="@(TextTheme.HasValue ? $"RGB: ({TextTheme.Value.R}, {TextTheme.Value.G}, {TextTheme.Value.B})" : "currentColor")"
                               @onchange="@(e => TextTheme = ColorTranslator.FromHtml(e?.Value?.ToString()))" />
                    </div>
                    <div class="col-6 col-form-label">Font</div>
                    <div class="col-6">
                        <input type="text" 
                               class="form-control" 
                               placeholder="inherit" 
                               value="@FontTheme" 
                               @onchange="@(e => FontTheme = e?.Value?.ToString())" />
                    </div>
                    <div class="col-12">
                        <HistChart Model="@model" Theme="@theme"></HistChart>
                    </div>
                </div>
            </div>
            <div class="col col-sm-6 col-lg-8 col-12">
                <div class="h-100 w-100 small border">
                    <pre class="language-csharp m-0 h-100">
                        <code>
 <span class="token comment">//Render chart and legend using a custom theme</span>
 &lt<span class="token tag bold">HistChart</span> <span class="token property bold">Theme</span><span class="token string">="</span>@@custom_theme<span class="token string">"</span> <span class="token property bold">Model</span><span class="token string">="</span>@@hist_model<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendHorizontal</span> <span class="token property bold">Theme</span><span class="token string">="</span>@@custom_theme<span class="token string">"</span> <span class="token property bold">Model</span><span class="token string">="</span>@@hist_model<span class="token string">"</span>/&gt
 
 <span class="token comment">//Or using a built-in static theme for both</span>
 &lt<span class="token tag bold">HistChart</span> <span class="token property bold">Theme</span><span class="token string">="</span><span class="token property">Theme</span>.Dark<span class="token string">"</span> <span class="token property bold">Model</span><span class="token string">="</span>@@hist_model<span class="token string">"</span>/&gt
 &lt<span class="token tag bold">LegendVertical</span> <span class="token property bold">Theme</span><span class="token string">="</span><span class="token property">Theme</span>.Dark<span class="token string">"</span> <span class="token property bold">Model</span><span class="token string">="</span>@@hist_model<span class="token string">"</span>/&gt
 
 @@{
     <span class="token comment">//Define you theme.</span>
     <span class="token keyword">private</span> <span class="token property">Theme</span> custom_theme = <span class="token keyword">new</span> <span class="token class-name">Theme</span>()
     {
         BackgroundColor = <span class="token property">Color</span>.Snow,
         AxisColor = <span class="token property">Color</span>.DarkGray,
         TextColor = <span class="token property">Color</span>.Black,
         FontFamily = <span class="token keyword">null</span> <span class="token comment">//Font will be inherited</span>
     };
 
     <span class="token comment">//Fill model with data.</span>
     <span class="token keyword">private</span> <span class="token property">Histogram</span> hist_model = <span class="token keyword">new</span> <span class="token class-name">Histogram</span>(<span class="token string">"Asse-X"</span>, <span class="token string">"Asse-Y"</span>, <span class="token class-name">Color</span>.LightSteelBlue, <span class="token class-name">Color</span>.MediumPurple);
 
     <span class="token keyword">for</span> (<span class="token variable">int</span> i = 0; i &lt 10; i++)
     {
         hist_model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Bin</span>()
         {
             Min = i,
             Max = i + 1,
             Value = 10 + 3 * i
         });
     }
 }
                        </code>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
