@namespace BlazorGraphs.Components

<div style="position: relative;" @onmousemove="OnMouseHover">
    <svg xmlns="http://www.w3.org/2000/svg" 
         style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
         viewBox="@(-LayoutView.Padding / 2) 0 @LayoutView.Width @LayoutView.Height"
         @key="@Model"
         @onmouseleave="() => SelectedBar = null">

        @if (Model is null || Model.IsEmpty)
        {
            <rect x="@LayoutView.Padding"
                  y="@LayoutView.Padding"
                  width="@LayoutView.InternalWidth"
                  height="@LayoutView.InternalHeight"
                  fill="@Theme.BackgroundString()" />
        }
        else
        {
            int originV = LayoutAxisY.StartingPoint.Y + (int)(Model.ValAxis.Origin * LayoutAxisY.Amplitude);

            foreach (KeyValuePair<string, Bin> kvp in Model)
            {
                string label = kvp.Key;
                Bin bin = kvp.Value;

                @if (bin.Value < 0)
                {
                    <rect x="@(LayoutAxisX.StartingPoint.X + (int)((bin.Min - Model.BinAxis.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size))"
                          y="@originV"
                          width="@((int)((bin.Max - bin.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size))"
                          height="@((int)(bin.Value * LayoutAxisY.Amplitude / Model.ValAxis.Size))"
                          fill="@(Model.SecondaryColor.ToHex())"
                          stroke="@(Model.SecondaryColor.ToHex())"
                          class="scale-down"
                          fill-opacity="0.6"
                          stroke-width="1px"
                          vector-effect="non-scaling-stroke"
                          @key="@bin"
                          @onclick="async () => await OnClick.InvokeAsync(new Bar(label, bin.Value))"
                          @onmouseenter="() => SelectedBar = new Bar(label, bin.Value)"
                          @onmouseleave="() => SelectedBar = null">
                    </rect>
                    @LayoutLabelsTop.At(LayoutAxisX.StartingPoint.X + (int)(((bin.Max + bin.Min) / 2 - Model.BinAxis.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size), originV).Render(label);
                }
                else
                {
                    <rect x="@(LayoutAxisX.StartingPoint.X + (int)((bin.Min - Model.BinAxis.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size))"
                          y="@(originV + (int)(bin.Value * LayoutAxisY.Amplitude / Model.ValAxis.Size))"
                          width="@((int)((bin.Max - bin.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size))"
                          height="@((int)(-bin.Value * LayoutAxisY.Amplitude / Model.ValAxis.Size))"
                          fill="@(Model.PrimaryColor.ToHex())"
                          stroke="@(Model.PrimaryColor.ToHex())"
                          class="scale-up"
                          fill-opacity="0.6"
                          stroke-width="1px"
                          vector-effect="non-scaling-stroke"
                          @key="@bin"
                          @onclick="async () => await OnClick.InvokeAsync(new Bar(label, bin.Value))"
                          @onmouseenter="() => SelectedBar = new Bar(label, bin.Value)"
                          @onmouseleave="() => SelectedBar = null">
                    </rect>
                    @LayoutLabelsBottom.At(LayoutAxisX.StartingPoint.X + (int)(((bin.Max + bin.Min) / 2 - Model.BinAxis.Min) * LayoutAxisX.Amplitude / Model.BinAxis.Size), originV).Render(label);
                }
            }
            @LayoutAxisY.Render(Model.ValAxis);
            @LayoutAxisX.At(originV).Render(Model.BinAxis);
            @LayoutTitle.At(LayoutView.Padding / 2, originV > LayoutView.Height / 2 ? LayoutView.Padding / 2 : LayoutView.Height - LayoutView.Padding / 2).Render(Model.Title);
        }
    </svg>
    @if (SelectedBar.HasValue)
    {
        <Tooltip Position="TooltipPosition" Theme="Theme">
            <table>
                <tr>
                    <td colspan="2" style="text-align: center;">@SelectedBar.Value.Label</td>
                </tr>
                <tr>
                    <td>
                        <svg width="1.5em" height="1em">
                            <rect x="0.1em"
                                  y="0.1em"
                                  width="0.8em"
                                  height="0.8em"
                                  fill="@(SelectedBar.Value.Value < 0 ? Model.SecondaryColor.ToHex() : Model.PrimaryColor.ToHex())" />
                        </svg>
                    </td>
                    <td>@SelectedBar.Value.Value.ToString("0.0#")</td>
                </tr>
            </table>
        </Tooltip>
    }
</div>
