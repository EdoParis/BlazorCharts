@page "/radarchart"

<PageTitle>RadarChart</PageTitle>

<h3>Radarchart</h3>
<p>
    A radar chart, also known as a spider chart, is a type of chart used to visualize multivariate data. 
    The chart consists of a series of spokes radiating out from a central point, with each spoke representing a different variable. 
    The data is plotted on each spoke using a line or area, and the end result looks like a spider web or star.
</p>
<div class="row row-cols-1 row-cols-md-2">
    <div class="col">
        <div class="card mx-auto fit-content overflow-hidden mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-form-label">Color</div>
                    <div class="col-6"><input type="color" class="form-control form-control-color w-100" value="@(model1.Color.ToHex())" @onchange="@((e) => model1.Color = ColorTranslator.FromHtml(e?.Value?.ToString()))" /></div>
                    <div class="col-6">Circular</div>
                    <div class="col-6"><div class="col-6 form-control-lg form-check form-switch form-check-reverse py-0 w-100"><input type="checkbox" class="form-check-input" @bind="@circular" /></div></div>
                    <div class="col-12">
                        <RadarChart Model="@model1" Circular="@circular"></RadarChart>
                    </div>
                    <div class="col-6"><button type="button" class="btn btn-danger w-100" @onclick="OnChartClear">Clear</button></div>
                    <div class="col-6"><button type="button" class="btn btn-primary w-100" @onclick="OnRatingAdd">Add Rating</button></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <h6>Code example</h6>
        <div class="w-100 small border">
            <pre class="language-csharp m-0">
                <code>
&lt<span class="token tag bold">RadarChart</span> <span class="token property bold">Model</span><span class="token string">="</span>@@model<span class="token string">"</span>
            <span class="token property bold">Circular</span><span class="token string">="</span>false<span class="token string">"</span>/&gt

@@{
    <span class="token keyword">private</span> <span class="token property">Radargram</span> model = <span class="token keyword">new</span> <span class="token class-name">Radargram</span>(<span class="token string">"RadarChart-1"</span>, <span class="token class-name">Color</span>.MediumVioletBlue);

    model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Rating</span>(<span class="token string">"R1"</span>, 10);
    model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Rating</span>(<span class="token string">"R2"</span>, 20);
    model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Rating</span>(<span class="token string">"R3"</span>, 30);
    model.<span class="token function">Add</span>(<span class="token keyword">new</span> <span class="token class-name">Rating</span>(<span class="token string">"R4"</span>, 15);
}
                </code>
            </pre>
        </div>
    </div>
</div>
