<svg viewBox="@(-padding / 2) 0 @width @height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@offsetH"
              y="@padding"
              width="@(width - 2 * padding)"
              height="@(height - 2 * padding)"
              fill="@Theme.BackgroundString()" />
    }
    else
    {
        foreach(Bin bin in Model)
        {
            @if (bin.Value < 0)
            {
                <rect x="@(offsetH + (int)((bin.Min - Model.AxisX.Min) * scaleH))"
                      y="@originV"
                      width="@((int)((bin.Max - bin.Min) * scaleH))"
                      height="@((int)(-bin.Value * scaleV))"
                      fill="@(Model.SecondaryColor.ToHex())"
                      stroke="@(Model.SecondaryColor.ToHex())"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      @key="@bin"
                      @onclick="async () => await OnClick.InvokeAsync(bin)">
                    <title>@bin.Value.ToString("0.##")</title>
                </rect>
            }
            else
            {
                <rect x="@(offsetH + (int)((bin.Min - Model.AxisX.Min) * scaleH))"
                      y="@(originV - (int)(bin.Value * scaleV))"
                      width="@((int)((bin.Max - bin.Min) * scaleH))"
                      height="@((int)(bin.Value * scaleV))"
                      fill="@(Model.PrimaryColor.ToHex())"
                      stroke="@(Model.PrimaryColor.ToHex())"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      @key="@bin"
                      @onclick="async () => await OnClick.InvokeAsync(bin)">
                    <title>@bin.Value.ToString("0.##")</title>
                </rect>
            }
        }

        int current_origin = originV;
        if (current_origin == padding)
        {
            @LayoutTitleY.At(padding / 2, height - padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(width / 2, padding / 4).Render(Model.TitleX);
            @LayoutAxisX.FullInternal().At(current_origin).WithStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else if (current_origin == height - padding)
        {
            @LayoutTitleY.At(padding / 2, padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(width / 2, height - padding / 4).Render(Model.TitleX);
            @LayoutAxisX.TicksInternal().At(current_origin).WithStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else if (Model?.AxisY?.Size / 2 > -Model?.AxisY.Min)
        {
            @LayoutTitleY.At(padding / 2, padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(width / 2, height - padding / 2).Render(Model.TitleX);
            @LayoutAxisX.TicksInternal().At(current_origin).WithoutStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
        else
        {
            @LayoutTitleY.At(padding / 2, height - padding / 2).Render(Model.TitleY);
            @LayoutTitleX.At(width / 2, padding / 2).Render(Model.TitleX);
            @LayoutAxisX.FullInternal().At(current_origin).WithoutStartTick().Render(Model.AxisX);
            @LayoutAxisY.Render(Model.AxisY);
        }
    }
</svg>
