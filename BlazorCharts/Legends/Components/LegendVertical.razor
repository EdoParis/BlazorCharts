@namespace BlazorGraphs.Components

<div style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString(); color: @Theme.TextColorString();">
    @if (Model != null)
    {
        foreach (LegendItem item in Model.ToLegend())
        {
            if (FlipItems)
            {
                <div class="legend-item-flipped">
                    <div class="text-truncate">@item.Text</div>
                    <svg width="1.5em"
                         height="1em"
                         viewBox="0 0 150 100">
                        <path d="@Theme.Markers.Series.Render(75, 50, 70, Theme.RoundedShapes)"
                              fill="@item.Color.ToHex()">
                        </path>
                    </svg>
                </div>
            }
            else
            {
                <div class="legend-item">
                    <svg width="1.5em"
                         height="1em"
                         viewBox="0 0 150 100">
                        <path d="@Theme.Markers.Series.Render(75, 50, 70, Theme.RoundedShapes)"
                              fill="@item.Color.ToHex()">
                        </path>
                    </svg>
                    <div class="text-truncate">@item.Text</div>
                </div>
            }
        }
    }
</div>