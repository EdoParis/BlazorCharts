@namespace BlazorGraphs.Components

<div style="position: relative;" @onmousemove="OnMouseHandler" @onmouseenter="OnMouseHandler">
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 @width @height"
         style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
         @key="@Model"
         @onmouseleave="OnSvgLeave">

        @if (Model is null)
        {
            <path d="@ArcPath(0, Math.PI)"
                  fill="none"
                  stroke="@Theme.AxisColorString()"
                  stroke-width="1px"
                  vector-effect="non-scaling-stroke"/>
        }
        else
        {
            if (Model.HasBreakPoints)
            {
                double start_degree = 0;
                foreach (Breakpoint breakpoint in Model)
                {
                    double degree = Math.PI * (breakpoint.Value - Model.Axis.Min) / Model.Axis.Size;
                    <path d="@ArcPath(start_degree, degree)"
                          fill="none"
                          stroke="@breakpoint.Color.ToHex()"
                          stroke-width="@padding"
                          stroke-opacity="0.6"
                          @onmouseenter="() => OnBreakpointEnter(breakpoint)"
                          @onmouseleave="OnBreakpointLeave">
                    </path>
                    start_degree = degree;
                }            
            }
            else if (Model.Axis.Contains(Model.Value))
            {
                double degree = Math.PI * (Model.Value - Model.Axis.Min) / Model.Axis.Size;

                <path d="@ArcPath(0, degree)"
                      fill="none"
                      stroke="@Model.Color.ToHex()"
                      stroke-width="@padding"
                      stroke-opacity="0.6"
                      @onmouseenter="OnGaugeEnter"
                      @onmouseleave="OnGaugeLeave">
                </path>
            }
            @AxisLayout.Render(Model.Axis);
            @TitleLayout.Render(Model.Title);
            @ValueLayout.Render(Model.Value);

            if (Model.HasBreakPoints && Model.Axis.Contains(Model.Value))
            {
                double rot = Math.PI * (Model.Value - Model.Axis.Min) / Model.Axis.Size;
                <path d="@BarPath(rot)"
                      fill="@((Theme.BackgroundColor ?? Color.White).ToHex())"
                      stroke="@Theme.AxisColorString()"
                      stroke-width="1px"
                      fill-opacity="1.0"
                      vector-effect="non-scaling-stroke"
                      @onmouseenter="OnGaugeEnter"
                      @onmouseleave="OnGaugeLeave">
                </path>
            }
        }
    </svg>
    @if (LayoutTooltip.Visible)
    {
        @LayoutTooltip.Render();
    }
</div>