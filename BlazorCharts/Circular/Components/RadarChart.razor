@namespace BlazorGraphs.Components

<svg viewBox="0 0 @width @height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <circle fill="@Theme.BackgroundString()"
                fill-opacity="1.0"
                stroke="@Theme.AxisColorString()"
                stroke-width="1px"
                vector-effect="non-scaling-stroke"
                cx="@((width / 2))"
                cy="@((height / 2))"
                r="@((Math.Min(width, height) - 2 * padding) / 2)"
                style="pointer-events: none;" />
    }
    else
    {
        int c = 0;
        foreach (Rating rating in Model)
        {
            <line x1="@(width / 2)"
                  y1="@(height / 2)"
                  x2="@((int)((width / 2 + (width / 2 - padding) * Math.Sin(2 * Math.PI / Model.Categories * c))))"
                  y2="@((int)((height / 2 - (height / 2 - padding) * Math.Cos(2 * Math.PI / Model.Categories * c))))"
                  stroke="@Theme.AxisColorString()"
                  stroke-width="1px"
                  stroke-opacity="0.3"
                  vector-effect="non-scaling-stroke"
                  @key="@rating"/>

            @LayoutLabels.At((int)((width / 2 + (width / 2 - padding / 2) * Math.Sin(2 * Math.PI / Model.Categories * c))),
                             (int)((height / 2 - (height / 2 - padding / 2) * Math.Cos(2 * Math.PI / Model.Categories * c)))).Render(rating.Label)
            c++;
        }

        int tr = 0;
        foreach (Tick tick in Model.AxisR.Ticks())
        {
            if (tr > 0 && tr % 5 == 0)
            {
                if (Circular)
                {
                    <circle fill="transparent"
                            stroke="@Theme.AxisColorString()"
                            stroke-width="1px"
                            stroke-opacity="0.3"
                            vector-effect="non-scaling-stroke"
                            cx="@((width / 2))"
                            cy="@((height / 2))"
                            r="@((int)(tick.RelativePosition * (Math.Min(width, height) / 2 - padding)))"
                            @key="@tick.RelativePosition" />
                }
                else
                {
                    <path fill="transparent"
                          stroke="@Theme.AxisColorString()"
                          stroke-width="1px"
                          stroke-opacity="0.3"
                          vector-effect="non-scaling-stroke"
                          d="@Path(tick.RelativePosition)"
                          @key="@tick.RelativePosition" />
                }
                @LayoutTicks.At(width / 2, (int)(height / 2 - tick.RelativePosition * (Math.Min(width, height) / 2 - padding))).Render(tick.Label);
            }
            tr++;
        }

        <g>
            <path fill="@Model.Color.ToHex()"
                  stroke="@Model.Color.ToHex()"
                  fill-opacity="0.3"
                  stroke-width="1px"
                  vector-effect="non-scaling-stroke"
                  class="fade-in"
                  d="@Path()"
                  @key="@Model.Categories">
            </path>

            @{
                int i = 0;
                foreach (Rating rating in Model)
                {
                    double r = rating.Value / Model.AxisR.Size * (Math.Min(width, height) - 2 * padding) / 2;
                    double x = width / 2 + r * Math.Sin(2 * Math.PI / Model.Categories * i);
                    double y = height / 2 - r * Math.Cos(2 * Math.PI / Model.Categories * i);
                    i++;

                    <circle fill="@(Theme.BackgroundColor.HasValue? Theme.BackgroundColor.Value.ToHex() : Model.Color.ToHex())"
                            stroke="@Model.Color.ToHex()"
                            stroke-width="1px"
                            vector-effect="non-scaling-stroke"
                            cx="@((int)x)"
                            cy="@((int)y)"
                            r="8px"
                            @key="@rating">
                            <title>@rating.Value.ToString("0.##")</title>
                    </circle>
                }
            }
        </g>
    }
</svg>