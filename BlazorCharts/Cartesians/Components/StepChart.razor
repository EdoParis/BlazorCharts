@namespace BlazorGraphs.Components

<svg xmlns="http://www.w3.org/2000/svg" 
     style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()"
     viewBox="@(-LayoutView.Padding / 2) 0 @LayoutView.Width @LayoutView.Height"
     @key="@Model"
     @onpointerleave="() => LayoutTooltip.Hide()"
     @onpointermove="(e) => LayoutTooltip.Move(e)"
     @onpointerenter="(e) => LayoutTooltip.Move(e)">

    @if (Model is null || Model.IsEmpty)
    {
        <rect x="@LayoutView.Padding"
              y="@LayoutView.Padding"
              width="@LayoutView.InternalWidth"
              height="@LayoutView.InternalHeight"
              fill="@Theme.BackgroundString()" />
    }
    else
    {
        @LayoutAxisX.Render(Model.AxisX);
        @LayoutAxisY.Render(Model.AxisY);
        @LayoutTitleX.Render(Model.TitleX);
        @LayoutTitleY.Render(Model.TitleY);

        foreach (Serie<Datapoint> serie in Model.Series)
        {
            if (!serie.IsEmpty)
            {
                string path = LinePath(serie);

                <g>
                    <path d="@path"
                          fill="none"
                          class="fade-in"
                          stroke="@serie.Color.ToHex()"
                          stroke-width="1px"
                          stroke-linejoin="round"
                          stroke-linecap="round"
                          vector-effect="non-scaling-stroke"
                          @onpointerenter="() => OnSerieEnter(serie)"
                          @onpointerleave="() => LayoutTooltip.Hide()">
                    </path>

                    @if (!HidePoints)
                    {
                        foreach (Datapoint point in serie.Data)
                        {
                            <circle fill="@(Theme.BackgroundColor.HasValue ? Theme.BackgroundColor.Value.ToHex() : serie.Color.ToHex())"
                                    stroke="@serie.Color.ToHex()"
                                    stroke-width="1px"
                                    vector-effect="non-scaling-stroke"
                                    class="fade-in"
                                    cx="@(LayoutView.Padding + (int)((point.X - Model.AxisX.Min) * LayoutView.InternalWidth / Model.AxisX.Size))"
                                    cy="@(LayoutView.Height - LayoutView.Padding - (int)((point.Y - Model.AxisY.Min) * LayoutView.InternalHeight / Model.AxisY.Size))"
                                    r="8px"
                                    @onpointerenter="() => OnPointEnter(point, serie.Color)"
                                    @onpointerleave="() => LayoutTooltip.Hide()">
                            </circle>
                        }
                    }
                </g>
            }
        }
    }
</svg>
@LayoutTooltip.Render()
