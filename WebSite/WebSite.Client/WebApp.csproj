    </Content>
    <Content Update="wwwroot\charts\scatterchart.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\charts\stepchart.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\charts\linechart.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\charts\horizontalbarchart.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
