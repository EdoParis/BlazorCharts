@namespace BlazorGraphs.Components

<svg viewBox="0 0 @width @height" xmlns="http://www.w3.org/2000/svg" @key="@Model" style="background-color: @Theme.BackgroundString(); font-family: @Theme.FontString()">
    @if (Model is null || Model.IsEmpty)
    {
        <circle fill="@Theme.BackgroundString()"
                fill-opacity="1.0"
                stroke="@Theme.AxisColorString()"
                stroke-width="1px"
                vector-effect="non-scaling-stroke"
                cx="@((width / 2))"
                cy="@((height / 2))"
                r="@((Math.Min(width, height) - 2 * padding) / 2)"
                style="pointer-events: none;" />
    }
    else
    {
        int tr = 0;
        foreach (Tick tick in Model.AxisR.Ticks())
        {
            if (tick.IsMaster && tick.RelativePosition > 0)
            {
                <circle fill="transparent"
                        stroke="@Theme.AxisColorString()"
                        stroke-width="1px"
                        stroke-opacity="0.3"
                        vector-effect="non-scaling-stroke"
                        cx="@((width / 2))"
                        cy="@((height / 2))"
                        r="@((int)(tick.RelativePosition * (Math.Min(width, height) / 2 - padding)))" />

                @LayoutTicks.At(width / 2, (int)(height / 2 - (height / 2 - padding) * tick.RelativePosition)).Render(tick.Label)
            }
            tr++;
        }

        double progress = 0;

        foreach(Slice slice in Model)
        {
            if (slice.Value <= 0)
                continue;

            if (slice.Value >= Model.Total)
            {
                <circle fill="@slice.Color.ToHex()"
                        class="fade-in"
                        stroke="@Theme.BackgroundString()"
                        fill-opacity="0.6"
                        stroke-width="1px"
                        vector-effect="non-scaling-stroke"
                        cx="@((width / 2))"
                        cy="@((height / 2))"
                        r="@((int)(slice.Value / Model.AxisR.Size * (Math.Min(width, height) - 2 * padding) / 2))"
                        @key="@slice"
                        @onclick="async () => await OnClick.InvokeAsync(slice)">
                    <title>@slice.Value.ToString("0.##")</title>
                </circle>
            }
            else
            {
                <path fill="@slice.Color.ToHex()"
                      class="fade-in"
                      stroke="@Theme.BackgroundString()"
                      fill-opacity="0.6"
                      stroke-width="1px"
                      vector-effect="non-scaling-stroke"
                      d="@SlicePath(slice, 2 * Math.PI * progress)"
                      @key="@slice"
                      @onclick="async () => await OnClick.InvokeAsync(slice)">
                    <title>@slice.Value.ToString("0.##")</title>
                </path>
            }
            progress += 1d / Model.SlicesCount;
        }
        @LayoutTitle.Render(Model?.Title);
    }
</svg>